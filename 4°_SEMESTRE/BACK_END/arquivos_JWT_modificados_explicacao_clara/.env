------------------------------------------------------------------------------
# CONFIGURAÇÕES DO BANCO DE DADOS (MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost          # Endereço onde o banco de dados está rodando (local)
DB_USER=root               # Usuário do banco de dados
DB_PASSWORD=root           # Senha de acesso ao banco de dados
DB_NAME=sabordigital_celso    # Nome da base de dados da aplicação
DB_PORT=3306               # Porta padrão de conexão do MySQL

# ------------------------------------------------------------------------------
# SEGREDO DE AUTENTICAÇÃO (JWT - JSON Web Token)
# ------------------------------------------------------------------------------
# JWT_SECRET: Chave secreta única da sua aplicação.
#
# COMO FUNCIONA NA PRÁTICA:
# 1. No Login (jwt.sign): O Node usa essa chave para "carimbar" e assinar o token.
# 2. No Middleware (jwt.verify): O Node usa essa mesma chave para verificar se
#    o token enviado pelo usuário é verdadeiro ou se foi alterado/forjado.
#
# REGRA PARA A PROVA:
# - Se o valor da JWT_SECRET for alterado, TODOS os tokens gerados anteriormente
#   se tornam inválidos imediatamente.
# - Ela DEVE ser uma string longa, aleatória e complexa.
JWT_SECRET='k9mP2$vX8@zQ5!wL3%dN7&sB4*fY6-hJ1'